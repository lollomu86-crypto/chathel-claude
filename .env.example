# ChatHel - variabili d'ambiente. Copia in .env.local. NON committare .env.local.
#
# MODALITA' DEMO: se NEXT_PUBLIC_SUPABASE_URL o NEXT_PUBLIC_SUPABASE_ANON_KEY mancano,
# l'app usa dati di esempio IN MEMORIA (si azzerano al riavvio). Nessun backend necessario.

# --- Supabase (regione UE). Lasciare vuoto per la modalita' demo ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOLO SERVER. Mai in codice client, mai con prefisso NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Reception AI (Anthropic). SOLO SERVER. Se vuota: risposte demo per parole chiave ---
ANTHROPIC_API_KEY=
# Modello da verificare sul listino corrente prima dell'uso (classe Haiku consigliata nel P0)
ANTHROPIC_MODEL=claude-haiku-4-5
# Tetto di risposte AI al giorno per hotel (controllo dei costi)
AI_HOTEL_DAILY_CAP=2000

# --- Solo demo ---
# Tetto stagionale del bonus nell'hotel demo (default 30). Metti 2 per provare "bonus esaurito".
DEMO_BONUS_CAP=30

# --- Modalita' e identita' (vedi NOTE-SVILUPPO.md) ---
# La demo NON parte per caso: serve CHATHEL_DEMO=1 esplicito. In produzione e' rifiutata (salvo CHATHEL_DEMO_ALLOW_PRODUCTION=1, sconsigliato).
CHATHEL_DEMO=
CHATHEL_DEMO_ALLOW_PRODUCTION=
# Segreto (>=32 caratteri casuali) per derivare la chiave d'identita' dell'ospite (HMAC). SOLO SERVER. Obbligatorio con Supabase.
IDENTITY_PEPPER=
# Intestazione con l'IP del client SOLO se dietro un proxy fidato (es. x-vercel-forwarded-for). Vuota = limite per IP disattivato.
TRUSTED_IP_HEADER=
# Webhook per gli avvisi di emergenza alla reception (payload senza testo dell'ospite). Canale non verificato.
EMERGENCY_WEBHOOK_URL=
# Solo demo: bonus massimi per ora (default 12)
DEMO_BONUS_PER_HOUR=
